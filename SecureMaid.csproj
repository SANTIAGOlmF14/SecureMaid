<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SecureMaid</AssemblyName>
    <RootNamespace>SecureMaid</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>

    <!-- Metadata del .exe: lo que ve el usuario en Propiedades > Detalles en Windows. -->
    <Product>SecureMaid</Product>
    <AssemblyTitle>SecureMaid</AssemblyTitle>
    <Company>SecureMaid</Company>
    <Description>Oculta, cifra y camufla archivos y carpetas.</Description>
    <Copyright>© 2026 SecureMaid</Copyright>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auto-actualizaciones e instalador via GitHub Releases. -->
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

 <ItemGroup>
  <!-- Los logos se copian al directorio de salida para poder cargarlos en
       tiempo de ejecucion (icono de ventana / selector de logo en Ajustes). -->
  <Content Include="Logos\**\*.png">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
  </Content>
</ItemGroup>

</Project>

<Window x:Class="SecureMaid.Views.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDark}"
        FontFamily="Segoe UI"
        Closing="OnWindowClosing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="16,10">
            <Grid>
                <TextBlock x:Name="FileNameText" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Cerrar ✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="OnCloseClick"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="▶ Reproducir" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnPlayClick"/>
                <Button Content="⏸ Pausar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnPauseClick"/>
                <Button Content="⏹ Detener" Style="{StaticResource GhostButton}" Click="OnStopClick"/>
            </StackPanel>
        </Border>
        <Grid Background="Black">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"/>
        </Grid>
    </DockPanel>
</Window>

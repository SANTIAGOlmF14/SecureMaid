<UserControl x:Class="SecureMaid.Views.DashboardView"
             xmlns:controls="clr-namespace:SecureMaid.Controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SecureMaid.Helpers">
    <UserControl.Resources>
        <helpers:BoolToVisConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisInverseConverter x:Key="BoolToVisInverse"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BgDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Encabezado: logo real de la app + nombre -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,16,32">
                    <Border Width="64" Height="64" CornerRadius="15" Background="{DynamicResource BgElevated}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                        <Image x:Name="SidebarLogo" Width="46" Height="46" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="SidebarAppName" Text="SecureMaid" Foreground="{DynamicResource TextPrimary}"
                               FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Pie: version + Bloquear, separados del menu con una linea -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,18">
                    <Border Style="{StaticResource Divider}" Margin="6,0,6,10"/>
                    <Button Click="OnLockClick" Style="{StaticResource SidebarActionButton}" ToolTip="Cerrar la sesion actual">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLock}" Width="16" Height="16" Stretch="Uniform" Margin="3,0,11,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Bloquear" VerticalAlignment="Center" FontSize="13.5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navegacion -->
                <StackPanel Margin="12,0">
                    <RadioButton x:Name="NavVault" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="OnNavChanged" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Width="17" Height="17" Stretch="Uniform" Margin="2,0,12,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Caja fuerte" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHide" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEye}" Width="17" Height="17" Stretch="Uniform" Margin="2,0,12,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Ocultar archivos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDisguise" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEyeOff}" Width="17" Height="17" Stretch="Uniform" Margin="2,0,12,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Camuflar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRecent" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClock}" Width="17" Height="17" Stretch="Uniform" Margin="2,0,12,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Recientes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}" Width="17" Height="17" Stretch="Uniform" Margin="2,0,12,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Ajustes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1" Margin="32,28,32,0">

            <!-- ==== Caja fuerte ==== -->
            <DockPanel x:Name="PanelVault" Visibility="Visible">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Caja fuerte" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Archivos cifrados con AES-256, guardados dentro de la app." Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="⬅ Subir" Style="{StaticResource GhostButton}" x:Name="VaultBackButton" Click="OnVaultGoUp" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <TextBlock x:Name="VaultBreadcrumb" Text="Caja fuerte" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Agregar archivo" Style="{StaticResource PrimaryButton}" Click="OnAddToVault"/>
                    <Button Content="+ Nueva carpeta" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnCreateVaultFolder"/>
                    <Button Content="Extraer seleccionados" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnExtractFromVault"/>
                    <Button Content="Eliminar de forma permanente" Style="{StaticResource DangerGhostButton}" Margin="10,0,0,0" Click="OnDeleteFromVault"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelperText}" Margin="0,0,0,10"
                           Text="Doble clic en una carpeta para entrar, en una imagen o video para verlo. Puedes seleccionar varios con Ctrl/Shift. Tambien puedes arrastrar archivos o carpetas desde el Explorador y soltarlos aqui."/>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,24" AllowDrop="True"
                      DragEnter="OnVaultDragEnter" DragOver="OnDragOverShowFileCopy" DragLeave="OnVaultDragLeave" Drop="OnVaultDrop">
                    <Border Style="{StaticResource Card}" Padding="10,4">
                        <ListView x:Name="VaultList" SelectionMode="Extended" MouseDoubleClick="OnVaultItemDoubleClick" MinHeight="240">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="52">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="34" Height="34">
                                                    <Border CornerRadius="7" Background="{DynamicResource BgElevated}"/>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding FallbackIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisInverse}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nombre" Width="320" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Tipo" Width="110" DisplayMemberBinding="{Binding KindDisplay}"/>
                                    <GridViewColumn Header="Tamaño" Width="110" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                    <GridViewColumn Header="Agregado" Width="170" DisplayMemberBinding="{Binding DateDisplay}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Border x:Name="VaultDropHint" Visibility="Collapsed" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDownload}" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"
                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Suelta aquí para agregarlo a la caja fuerte" Foreground="{DynamicResource Accent}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- ==== Ocultar ==== -->
            <DockPanel x:Name="PanelHide" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Ocultar archivos y carpetas" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" MaxWidth="760"
                               Text="Completo: se mueve a un almacen controlado por la app y se marca como archivo de sistema; no aparece en galerias, busquedas ni en el Inicio del Explorador. Parcial: se queda en su sitio, solo pierde el nombre y (si es carpeta) el icono, y puedes seguir abriendolo con doble clic. Para verlo de nuevo hay que restaurarlo aqui con tu contraseña."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Ocultar carpeta" Style="{StaticResource PrimaryButton}" Click="OnHideFolder"/>
                    <Button Content="+ Ocultar archivo" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnHideFile"/>
                    <Button Content="Restaurar seleccionado" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnUnhide"/>
                    <Button Content="Abrir seleccionado" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnOpenHidden"/>
                </StackPanel>
                <CheckBox x:Name="ChkHideInvisible" DockPanel.Dock="Top" Margin="0,0,0,14"
                          Content="Ocultamiento parcial: sin nombre ni icono, se queda en su lugar (en vez de moverlo y ocultarlo por completo)"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HelperText}" Margin="0,-6,0,10"
                           Text="Tambien puedes arrastrar archivos o carpetas desde el Explorador y soltarlos aqui."/>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,24" AllowDrop="True"
                      DragEnter="OnHideDragEnter" DragOver="OnDragOverShowFileCopy" DragLeave="OnHideDragLeave" Drop="OnHideDrop">
                    <Border Style="{StaticResource Card}" Padding="10,4">
                        <ListView x:Name="HideList" MinHeight="240" MouseDoubleClick="OnOpenHidden">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Ruta original" Width="420" DisplayMemberBinding="{Binding OriginalPath}"/>
                                    <GridViewColumn Header="Tipo" Width="90" DisplayMemberBinding="{Binding TypeDisplay}"/>
                                    <GridViewColumn Header="Modo" Width="200" DisplayMemberBinding="{Binding ModeDisplay}"/>
                                    <GridViewColumn Header="Oculto desde" Width="150" DisplayMemberBinding="{Binding DateDisplay}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Border x:Name="HideDropHint" Visibility="Collapsed" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconDownload}" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"
                                  Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="Suelta aquí para ocultarlo" Foreground="{DynamicResource Accent}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- ==== Camuflar ==== -->
            <ScrollViewer x:Name="PanelDisguise" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,28" PreviewMouseWheel="OnPanelScroll">
                <StackPanel>
                    <TextBlock Text="Camuflar carpetas y archivos" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"
                               Text="La carpeta o archivo conserva su contenido real, pero se le cambia el nombre y el icono para que no llame la atencion. Opcionalmente puedes protegerlo con contraseña, y siempre puedes descamuflarlo para dejarlo como estaba."/>

                    <!-- Formulario para camuflar un elemento nuevo -->
                    <Grid Margin="0,0,0,24" AllowDrop="True"
                          DragEnter="OnDisguiseDragEnter" DragOver="OnDragOverShowFileCopy" DragLeave="OnDisguiseDragLeave" Drop="OnDisguiseDrop">
                        <Border Style="{StaticResource Card}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Camuflar un elemento nuevo" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource CardDesc}" Margin="0,0,0,18"
                                       Text="Elige una carpeta o archivo, o arrastralo a esta tarjeta directamente desde el Explorador."/>

                            <TextBlock Text="Carpeta o archivo a camuflar" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DisguisePathBox" Grid.Column="0" IsReadOnly="True" FontSize="14.5" Padding="16,13"/>
                                <Button Grid.Column="1" Content="Elegir..." ToolTip="Elegir una carpeta" Style="{StaticResource GhostButton}" Padding="20,13" Margin="12,0,0,0" Click="OnPickDisguiseFolder"/>
                                <Button Grid.Column="2" Content="Archivo..." ToolTip="Elegir un archivo" Style="{StaticResource GhostButton}" Padding="20,13" Margin="12,0,0,0" Click="OnPickDisguiseFile"/>
                            </Grid>

                            <TextBlock Text="Nuevo nombre visible" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,10"/>
                            <TextBox x:Name="DisguiseNameBox" FontSize="14.5" Padding="16,13" Margin="0,0,0,20"/>

                            <TextBlock Text="Icono" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DisguiseFileIconHint" Style="{StaticResource HelperText}" Margin="0,-4,0,10" Visibility="Collapsed"
                                       Text="Los archivos toman el icono de la extension del nuevo nombre (por ejemplo .txt, .dll o .docx), asi que este selector aplica solo a carpetas."/>
                            <ComboBox x:Name="DisguiseIconCombo" FontSize="14.5" Padding="16,13,40,13" Margin="0,0,0,20"/>

                            <!-- Proteccion opcional con contraseña -->
                            <CheckBox x:Name="DisguiseProtectCheck" Style="{StaticResource SwitchCheckBox}" Content="Proteger con contraseña (opcional)"
                                      Margin="0,0,0,20" Checked="OnDisguiseProtectToggled" Unchecked="OnDisguiseProtectToggled"/>
                            <StackPanel x:Name="DisguiseProtectPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                <TextBlock Text="¿Que contraseña quieres usar para protegerlo?" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource SegmentedGroup}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="DisguisePwdMasterOption" GroupName="DisguisePwd" Style="{StaticResource SegmentedOption}"
                                                     Content="Contraseña general de la app" Checked="OnDisguisePwdModeChanged"/>
                                        <RadioButton x:Name="DisguisePwdCustomOption" GroupName="DisguisePwd" Style="{StaticResource SegmentedOption}"
                                                     Content="Contraseña nueva e independiente" Checked="OnDisguisePwdModeChanged"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="DisguisePwdMasterHint" Style="{StaticResource HelperText}" Margin="0,0,0,18" Visibility="Collapsed"
                                           Text="Se usara la contraseña con la que entras a la app. Si algun dia la cambias, la proteccion se actualiza sola."/>
                                <StackPanel x:Name="DisguisePwdCustomPanel" Visibility="Collapsed">
                                    <TextBlock Text="Nueva contraseña para este elemento" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,10"/>
                                    <controls:PasswordField x:Name="DisguisePwdBox" Margin="0,0,0,14"/>
                                    <TextBlock Text="Repite la contraseña" Style="{StaticResource FieldLabel}" FontSize="13" Margin="0,0,0,10"/>
                                    <controls:PasswordField x:Name="DisguisePwdBox2" Margin="0,0,0,10"/>
                                    <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,18"
                                               Text="Minimo 6 caracteres. Esta contraseña solo abre este elemento y no se puede recuperar: si la olvidas, su contenido no se podra restaurar."/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,18"
                                           Text="Con contraseña, el contenido se cifra: no se podra abrir hasta que lo descamufles introduciendo la contraseña correcta. Sin contraseña, solo se cambia el nombre y el icono."/>
                            </StackPanel>

                            <Button Content="Aplicar camuflaje" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Padding="22,13" Click="OnApplyDisguise"/>
                        </StackPanel>
                        </Border>
                        <Border x:Name="DisguiseDropHint" Visibility="Collapsed" Background="{DynamicResource AccentSoft}"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDownload}" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center"
                                      Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="Suelta aquí para camuflarlo" Foreground="{DynamicResource Accent}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Toolbar de acciones sobre elementos ya camuflados, igual que en Caja fuerte / Ocultar -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Descamuflar permanente" Style="{StaticResource PrimaryButton}" Click="OnUndisguise"/>
                        <Button Content="Descamuflar rapido" ToolTip="Lo deja visible para que revises su contenido, sin sacarlo de esta lista."
                                Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnRevealQuick"/>
                        <Button Content="Volver a camuflar" ToolTip="Solo para un elemento que dejaste visible con 'Descamuflar rapido'"
                                Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnReCamouflage"/>
                        <Button Content="Carpeta anterior..." ToolTip="Para carpetas camufladas antes de que existiera este registro"
                                Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnUndisguiseLegacyFolder"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,10"
                               Text="Selecciona un elemento de la lista y elige una accion. Si esta protegido con una contraseña propia, te la pedira."/>

                    <Border Style="{StaticResource Card}" Padding="10,4" Margin="0,0,0,10">
                        <ListView x:Name="DisguiseList" MinHeight="240">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nombre visible" Width="160" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="Original" Width="130" DisplayMemberBinding="{Binding OriginalName}"/>
                                    <GridViewColumn Header="Tipo" Width="70" DisplayMemberBinding="{Binding TypeDisplay}"/>
                                    <GridViewColumn Header="Proteccion" Width="130" DisplayMemberBinding="{Binding ProtectionDisplay}"/>
                                    <GridViewColumn Header="Estado" Width="140" DisplayMemberBinding="{Binding StatusDisplay}"/>
                                    <GridViewColumn Header="Desde" Width="90" DisplayMemberBinding="{Binding DateDisplay}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <TextBlock x:Name="DisguiseEmptyText" Style="{StaticResource HelperText}" Margin="0,0,0,8"
                               Text="Aun no has camuflado nada desde esta version de la app."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Recientes ==== -->
            <ScrollViewer x:Name="PanelRecent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,28" PreviewMouseWheel="OnPanelScroll">
                <StackPanel>
                    <TextBlock Text="Limpiar rastros recientes" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,32" MaxWidth="760"
                               Text="Cuando ocultas algo, la app ya limpia automaticamente sus accesos en Recientes. Aqui puedes hacer una limpieza manual adicional si lo necesitas."/>
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Stretch" Padding="40,36">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource BgElevated}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,26">
                                <Path Data="{StaticResource IconBroom}" Width="28" Height="28" Stretch="Uniform"
                                      Stroke="{DynamicResource Accent2}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>

                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="22,18" Margin="0,0,0,14" Click="OnClearRecentShortcuts">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="Vaciar accesos de 'Reciente' del Explorador" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Borra los atajos a archivos abiertos recientemente que Windows muestra en el Explorador."
                                                   Style="{StaticResource CardDesc}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Path Grid.Column="1" Data="{StaticResource IconTrash}" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="22,18" Click="OnClearJumpLists">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel HorizontalAlignment="Left">
                                        <TextBlock Text="Vaciar listas de 'abiertos recientemente' (Jump Lists)" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Limpia los menus rapidos que aparecen al hacer clic derecho sobre un icono en la barra de tareas."
                                                   Style="{StaticResource CardDesc}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Path Grid.Column="1" Data="{StaticResource IconTrash}" Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="RecentStatus" Style="{StaticResource SuccessInlineText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,22,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==== Ajustes ==== -->
            <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,28" PreviewMouseWheel="OnPanelScroll">
                <StackPanel>
                    <TextBlock Text="Ajustes y camuflaje de la app" Style="{StaticResource PageTitle}" Margin="0,0,0,22"/>

                    <!-- Apariencia -->
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Stretch" Padding="36,32" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Apariencia" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Elige como se ve SecureMaid. El cambio se aplica al instante." Style="{StaticResource CardDesc}" Margin="0,0,0,14"/>
                            <Border Style="{StaticResource SegmentedGroup}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeDarkOption" GroupName="Theme" Style="{StaticResource SegmentedOption}" Checked="OnThemeOptionChanged">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconMoon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                            <TextBlock Text="Oscuro" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeLightOption" GroupName="Theme" Style="{StaticResource SegmentedOption}" Checked="OnThemeOptionChanged">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSun}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                            <TextBlock Text="Claro" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Identidad de la app -->
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Stretch" Padding="36,32" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Identidad de la app" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Como se muestra SecureMaid en la barra de titulo y la barra de tareas." Style="{StaticResource CardDesc}" Margin="0,0,0,16"/>

                            <TextBlock Text="Nombre visible de la app" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                            <TextBox x:Name="AppNameBox" Margin="0,0,0,16"/>

                            <CheckBox x:Name="DecoyCheck" Style="{StaticResource SwitchCheckBox}" Content="Activar modo señuelo (mostrar una calculadora al abrir la app)" Margin="0,0,0,18"/>

                            <Button Content="Guardar ajustes" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnSaveSettings"/>
                        </StackPanel>
                    </Border>

                    <!-- Cambiar contraseña -->
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Stretch" Padding="36,32" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Cambiar contraseña" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Escribe tu contraseña actual y luego la nueva. Todos tus archivos de la caja fuerte se vuelven a cifrar automáticamente con la contraseña nueva."
                                       Style="{StaticResource CardDesc}" Margin="0,0,0,16"/>

                            <TextBlock Text="Contraseña actual" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                            <controls:PasswordField x:Name="OldPasswordBox" Margin="0,0,0,14"/>

                            <TextBlock Text="Nueva contraseña" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                            <controls:PasswordField x:Name="NewPasswordBoxSettings" Margin="0,0,0,14"/>

                            <TextBlock Text="Confirmar nueva contraseña" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                            <controls:PasswordField x:Name="NewPasswordBoxSettings2" Margin="0,0,0,14"/>

                            <StackPanel x:Name="ChangePasswordAnswerPanel" Visibility="Collapsed">
                                <TextBlock x:Name="ChangePasswordQuestionText" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBox x:Name="ChangePasswordAnswerBox" Margin="0,0,0,14"/>
                            </StackPanel>

                            <TextBlock x:Name="ChangePasswordError" Style="{StaticResource ErrorInlineText}" Margin="0,0,0,12" Visibility="Collapsed"/>

                            <Button Content="Cambiar contraseña" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnChangePassword"/>
                            <TextBlock x:Name="ChangePasswordStatus" Style="{StaticResource SuccessInlineText}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Pregunta de seguridad -->
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Stretch" Padding="36,32" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Pregunta de seguridad" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Se usa para recuperar el acceso desde el enlace '¿Olvidaste tu contraseña?' en el login, si alguna vez la olvidas."
                                       Style="{StaticResource CardDesc}" Margin="0,0,0,14"/>

                            <TextBlock x:Name="SecurityQuestionCurrentText" Style="{StaticResource SuccessInlineText}" Margin="0,0,0,12" Visibility="Collapsed"/>
                            <TextBlock x:Name="SecurityQuestionMissingText" Style="{StaticResource ErrorInlineText}" Margin="0,0,0,12"
                                       Text="⚠ Aún no tienes una pregunta de seguridad configurada. Sin ella no podrás recuperar tu contraseña si la olvidas."/>

                            <Button x:Name="SecurityQuestionToggleButton" Content="Configurar pregunta de seguridad" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,16" Click="OnToggleSecurityQuestionForm"/>

                            <StackPanel x:Name="SecurityQuestionForm" Visibility="Collapsed">
                                <Border Style="{StaticResource Divider}" Margin="0,0,0,16"/>
                                <TextBlock Text="Pregunta" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="SecurityQuestionCombo" Margin="0,0,0,14" SelectionChanged="OnSecurityQuestionComboChanged">
                                    <ComboBoxItem Content="¿Cuál es el nombre de tu primera mascota?" IsSelected="True"/>
                                    <ComboBoxItem Content="¿En qué ciudad naciste?"/>
                                    <ComboBoxItem Content="¿Cuál es tu comida favorita?"/>
                                    <ComboBoxItem Content="¿Cómo se llamaba tu mejor amigo de la infancia?"/>
                                    <ComboBoxItem Content="Otra (la escribo yo)"/>
                                </ComboBox>
                                <TextBox x:Name="SecurityQuestionCustomBox" Visibility="Collapsed" Margin="0,0,0,14"/>

                                <TextBlock Text="Respuesta" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBox x:Name="SecurityQuestionAnswerBox" Margin="0,0,0,8"/>
                                <TextBlock Text="⚠ Quien sepa esta respuesta podrá restablecer tu contraseña: evita algo obvio o público."
                                           Style="{StaticResource HelperText}" Margin="0,0,0,16"/>

                                <TextBlock x:Name="SecurityQuestionError" Style="{StaticResource ErrorInlineText}" Margin="0,0,0,12" Visibility="Collapsed"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="OnSaveSecurityQuestion"/>
                                    <Button Content="Cancelar" Style="{StaticResource GhostButton}" Click="OnCancelSecurityQuestionForm"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Logo de la app -->
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Stretch" Padding="36,32" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Logo de la app" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Se usa como icono de la ventana y de la barra de tareas mientras la app esta abierta." Style="{StaticResource CardDesc}" Margin="0,0,0,16"/>
                            <ItemsControl x:Name="LogoList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnLogoOptionClick" Tag="{Binding FileName}"
                                                Margin="0,0,10,10" Padding="6" Background="{Binding HighlightBrush}"
                                                BorderBrush="{DynamicResource Accent}" BorderThickness="{Binding BorderThickness}"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="8">
                                                        <StackPanel Width="70">
                                                            <Border Width="54" Height="54" CornerRadius="8" Background="{DynamicResource BgElevated}" HorizontalAlignment="Center">
                                                                <Image Source="{Binding Preview}" Width="42" Height="42" Stretch="Uniform"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}"
                                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Acceso directo camuflado -->
                    <Border Style="{StaticResource Card}" MaxWidth="720" HorizontalAlignment="Stretch" Padding="36,32" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Crear acceso directo camuflado" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                            <TextBlock Text="Crea un acceso en el Escritorio con el nombre de arriba y un icono comun (los mismos que usa 'Camuflar'), para no tener que buscar el .exe real." Style="{StaticResource CardDesc}" Margin="0,0,0,14"/>
                            <ComboBox x:Name="ShortcutIconCombo" Margin="0,0,0,14"/>
                            <Button Content="Crear acceso directo en el Escritorio" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnCreateShortcut"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SettingsStatus" Style="{StaticResource SuccessInlineText}" Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>

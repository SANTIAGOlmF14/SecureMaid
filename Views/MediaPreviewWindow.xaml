<Window x:Class="SecureMaid.Views.MediaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa" Height="720" Width="1100" MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="{DynamicResource BgDark}"
        FontFamily="Segoe UI"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel>

        <!-- ===== Encabezado ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText" Foreground="{DynamicResource TextPrimary}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                    <TextBlock x:Name="CounterText" Foreground="{DynamicResource TextTertiary}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Cerrar ✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="OnCloseClick"/>
            </Grid>
        </Border>

        <!-- ===== Controles de video (solo visibles si el item actual es un video) ===== -->
        <Border x:Name="VideoControlsBar" DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="20,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PlayPauseButton" Grid.Column="0" Style="{StaticResource MediaControlButton}" Click="OnPlayPauseClick" Margin="0,0,10,0">
                    <Path x:Name="PlayPauseIcon" Data="{StaticResource IconPause}" Fill="{DynamicResource TextPrimary}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource MediaControlButton}" Click="OnStopClick" Margin="0,0,20,0">
                    <Path Data="{StaticResource IconStop}" Fill="{DynamicResource TextPrimary}" Width="14" Height="14" Stretch="Uniform"/>
                </Button>

                <TextBlock Grid.Column="2" x:Name="CurrentTimeText" Text="0:00" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                           VerticalAlignment="Center" MinWidth="38" Margin="0,0,10,0"/>

                <Slider Grid.Column="3" x:Name="SeekSlider" Style="{StaticResource SeekSlider}" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        Thumb.DragStarted="OnSeekDragStarted" Thumb.DragCompleted="OnSeekDragCompleted" ValueChanged="OnSeekValueChanged"/>

                <TextBlock Grid.Column="4" x:Name="DurationText" Text="0:00" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                           VerticalAlignment="Center" MinWidth="38" Margin="10,0,0,0" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ===== Contenido: imagen o video, con flechas de anterior/siguiente ===== -->
        <Grid x:Name="MediaStage" Background="#0A0A0F" ClipToBounds="True">
            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="24" RenderTransformOrigin="0.5,0.5"
                   MouseWheel="OnImageMouseWheel"
                   PreviewMouseLeftButtonDown="OnImageMouseLeftButtonDown"
                   MouseMove="OnImageMouseMove"
                   PreviewMouseLeftButtonUp="OnImageMouseLeftButtonUp">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ImageTranslateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                          Visibility="Collapsed" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded"/>
            <TextBlock x:Name="VideoLoadingText" Text="Cargando video…" Foreground="{DynamicResource TextSecondary}"
                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       IsHitTestVisible="False"/>

            <Button x:Name="PrevButton" Style="{StaticResource PreviewNavButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0"
                    Click="OnPrevClick" ToolTip="Anterior (flecha izquierda)">
                <Path Data="{StaticResource IconChevronLeft}" Stroke="White" StrokeThickness="2.4" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="22" Stretch="Uniform"/>
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource PreviewNavButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0"
                    Click="OnNextClick" ToolTip="Siguiente (flecha derecha)">
                <Path Data="{StaticResource IconChevronRight}" Stroke="White" StrokeThickness="2.4" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="22" Stretch="Uniform"/>
            </Button>
        </Grid>
    </DockPanel>
</Window>

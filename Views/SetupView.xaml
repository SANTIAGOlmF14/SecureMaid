<UserControl x:Class="SecureMaid.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SecureMaid.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BgDark}" PreviewMouseWheel="OnPanelScroll">
        <Grid Background="{DynamicResource BgDark}">
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32" Padding="30,28">
                <StackPanel>
                    <Border Width="112" Height="112" CornerRadius="24" Background="{DynamicResource BgElevated}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image x:Name="LogoImage" Width="82" Height="82" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Bienvenido a SecureMaid" Style="{StaticResource PageTitle}" FontSize="21" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Crea tu contraseña maestra. Protege tu caja fuerte y tus archivos ocultos."
                               Style="{StaticResource PageSubtitle}" TextAlignment="Center" Margin="0,8,0,26"/>

                    <TextBlock Text="Contraseña maestra" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <controls:PasswordField x:Name="PasswordBox1" Margin="0,0,0,16"/>

                    <TextBlock Text="Confirmar contraseña" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <controls:PasswordField x:Name="PasswordBox2" Margin="0,0,0,22"/>

                    <Border Style="{StaticResource Divider}" Margin="0,0,0,18"/>

                    <TextBlock Text="Pregunta de seguridad" Style="{StaticResource CardTitle}" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="Se usa para recuperar el acceso si olvidas tu contraseña." Style="{StaticResource CardDesc}" Margin="0,0,0,12"/>
                    <ComboBox x:Name="SecurityQuestionCombo" Margin="0,0,0,12" SelectionChanged="OnSecurityQuestionChanged">
                        <ComboBoxItem Content="¿Cuál es el nombre de tu primera mascota?" IsSelected="True"/>
                        <ComboBoxItem Content="¿En qué ciudad naciste?"/>
                        <ComboBoxItem Content="¿Cuál es tu comida favorita?"/>
                        <ComboBoxItem Content="¿Cómo se llamaba tu mejor amigo de la infancia?"/>
                        <ComboBoxItem Content="Otra (la escribo yo)"/>
                    </ComboBox>
                    <TextBox x:Name="CustomQuestionBox" Visibility="Collapsed" Margin="0,0,0,12"/>

                    <TextBlock Text="Respuesta" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                    <TextBox x:Name="SecurityAnswerBox" Margin="0,0,0,8"/>
                    <TextBlock Text="⚠ Quien sepa esta respuesta podrá restablecer tu contraseña: evita algo obvio o público."
                               Style="{StaticResource HelperText}" Margin="0,0,0,22"/>

                    <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorInlineText}"
                               Margin="0,0,0,16" Visibility="Collapsed"/>

                    <Button Content="Crear y continuar" Style="{StaticResource PrimaryButton}" Click="OnCreateClick"/>

                    <TextBlock Text="⚠ Si además olvidas la respuesta a tu pregunta de seguridad, no hay forma de recuperar tus archivos. Guárdalas en un lugar seguro."
                               Style="{StaticResource HelperText}" TextAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

<Window x:Class="SecureMaid.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDark}"
        FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="16,10">
            <Grid>
                <TextBlock x:Name="FileNameText" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Cerrar ✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="OnCloseClick"/>
            </Grid>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0A0A0F">
            <Image x:Name="PreviewImage" Stretch="Uniform" MaxWidth="1400" MaxHeight="1400"/>
        </ScrollViewer>
    </DockPanel>
</Window>

<UserControl x:Class="SecureMaid.Views.DecoyCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1E1E1E">
        <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#2D2D2D" CornerRadius="8" Padding="12">
            <StackPanel>
                <Border Background="#1A1A1A" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <TextBlock x:Name="Display" Text="0" FontSize="32" Foreground="White"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                </Border>
                <UniformGrid Columns="4" Rows="5">
                    <Button Content="C" Click="OnClear" Style="{StaticResource CalcOp}"/>
                    <Button Content="±" Click="OnSign" Style="{StaticResource CalcOp}"/>
                    <Button Content="%" Click="OnPercent" Style="{StaticResource CalcOp}"/>
                    <Button Content="÷" Click="OnOperator" Tag="/" Style="{StaticResource CalcOp}"/>

                    <Button Content="7" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="8" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="9" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="×" Click="OnOperator" Tag="*" Style="{StaticResource CalcOp}"/>

                    <Button Content="4" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="5" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="6" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="-" Click="OnOperator" Tag="-" Style="{StaticResource CalcOp}"/>

                    <Button Content="1" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="2" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="3" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="+" Click="OnOperator" Tag="+" Style="{StaticResource CalcOp}"/>

                    <Button Content="0" Click="OnDigit" Style="{StaticResource CalcNum}"/>
                    <Button Content="." Click="OnDot" Style="{StaticResource CalcNum}"/>
                    <Button Content="⌫" Click="OnBackspace" Style="{StaticResource CalcOp}"/>
                    <Button Content="=" Click="OnEquals" Style="{StaticResource CalcEquals}"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

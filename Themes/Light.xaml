<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Tema claro ===== -->

    <SolidColorBrush x:Key="BgDark" Color="#F1F1F7"/>
    <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgElevated" Color="#F5F5FA"/>
    <SolidColorBrush x:Key="BgHover" Color="#ECECF5"/>
    <SolidColorBrush x:Key="BgPressed" Color="#E2E2EF"/>

    <SolidColorBrush x:Key="Accent" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6D28D9"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1A7C3AED"/>
    <SolidColorBrush x:Key="Accent2" Color="#0D9488"/>
    <SolidColorBrush x:Key="Accent2Soft" Color="#1A0D9488"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#17171F"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5C5C74"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#8B8BA0"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1ADC2626"/>
    <SolidColorBrush x:Key="Success" Color="#059669"/>
    <SolidColorBrush x:Key="Warning" Color="#D97706"/>

    <SolidColorBrush x:Key="Border" Color="#E4E4F0"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#D2D2E4"/>
    <SolidColorBrush x:Key="InputBg" Color="#FAFAFD"/>
    <SolidColorBrush x:Key="InputBorder" Color="#D8D8E8"/>
    <SolidColorBrush x:Key="Overlay" Color="#66000000"/>
    <SolidColorBrush x:Key="Scrollbar" Color="#22000000"/>
    <SolidColorBrush x:Key="ScrollbarHover" Color="#3D000000"/>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="ThemeName">Light</system:String>

</ResourceDictionary>

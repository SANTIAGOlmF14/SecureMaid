<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Tema oscuro ===== -->

    <SolidColorBrush x:Key="BgDark" Color="#0A0A11"/>
    <SolidColorBrush x:Key="BgPanel" Color="#13131D"/>
    <SolidColorBrush x:Key="BgCard" Color="#1A1A27"/>
    <SolidColorBrush x:Key="BgElevated" Color="#20202F"/>
    <SolidColorBrush x:Key="BgHover" Color="#26263A"/>
    <SolidColorBrush x:Key="BgPressed" Color="#2C2C42"/>

    <SolidColorBrush x:Key="Accent" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentHover" Color="#9D74FA"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#268B5CF6"/>
    <SolidColorBrush x:Key="Accent2" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="Accent2Soft" Color="#262DD4BF"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5FA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#9C9CB4"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#6C6C85"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Danger" Color="#F55A6C"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#26F55A6C"/>
    <SolidColorBrush x:Key="Success" Color="#34D399"/>
    <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>

    <SolidColorBrush x:Key="Border" Color="#26263A"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#34344A"/>
    <SolidColorBrush x:Key="InputBg" Color="#12121B"/>
    <SolidColorBrush x:Key="InputBorder" Color="#2C2C42"/>
    <SolidColorBrush x:Key="Overlay" Color="#B3000000"/>
    <SolidColorBrush x:Key="Scrollbar" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScrollbarHover" Color="#55FFFFFF"/>

    <!-- Nombre visible del tema, para poder mostrarlo/depurar si hace falta -->
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="ThemeName">Dark</system:String>

</ResourceDictionary>

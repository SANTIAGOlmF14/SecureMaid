<Window x:Class="SecureMaid.Controls.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI" KeyDown="OnWindowKeyDown">
    <Border Style="{StaticResource Card}" MinWidth="360" MaxWidth="440" Margin="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="IconText" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="CaptionText" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>

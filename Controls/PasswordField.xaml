<UserControl x:Class="SecureMaid.Controls.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <PasswordBox x:Name="InnerPasswordBox" Padding="14,11,44,11" KeyDown="OnInnerKeyDown"/>
            <TextBox x:Name="InnerTextBox" Padding="14,11,44,11" Visibility="Collapsed" KeyDown="OnInnerKeyDown"/>
            <Button x:Name="ToggleButton" Style="{StaticResource IconButton}" Width="34" Height="34"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                    Click="OnToggleClick" ToolTip="Mostrar contraseña">
                <Path x:Name="EyeIcon" Data="{StaticResource IconEye}" Stretch="Uniform" Width="17" Height="17"
                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
